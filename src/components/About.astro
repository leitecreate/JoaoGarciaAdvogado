---
import { Image } from "astro:assets";
import { ArrowUpRight, AtSign } from "@lucide/astro";
import portraitImage from "../assets/joao-portrait.png";
import { siteConfig } from "../config/site";
---

<section class="section about" id="sobre" aria-labelledby="about-title">
  <div class="container-wide about__grid">
    <div class="about__visual" data-reveal>
      <Image
        src={portraitImage}
        alt="Retrato profissional de João Garcia"
        width={338}
        sizes="(max-width: 767px) 72vw, 338px"
        format="webp"
        loading="lazy"
      />
      <span class="about__photo-line" aria-hidden="true"></span>
    </div>
    <div class="about__content" data-reveal>
      <p class="eyebrow eyebrow--gold">João Garcia · Advogado</p>
      <h2 id="about-title">Atuação com firmeza e estratégia.</h2>
      <p class="about__lead">
        João Garcia é advogado, pós-graduando pela PUC e atua com conteúdo e orientação relacionados à Reforma Tributária.
      </p>
      <a class="instagram-link" href={siteConfig.instagramUrl} target="_blank" rel="noopener noreferrer">
        <AtSign size={19} stroke-width={1.6} />
        <span><strong>{siteConfig.instagram}</strong> Acompanhar conteúdos</span>
        <ArrowUpRight size={18} stroke-width={1.6} />
      </a>
    </div>
  </div>
</section>
