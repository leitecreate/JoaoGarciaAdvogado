---
import { Image } from "astro:assets";
import heroImage from "../assets/joao-hero.jpg";
import { siteConfig } from "../config/site";
import ButtonLink from "./ButtonLink.astro";
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__image-wrap" data-hero-image>
    <Image
      class="hero__image"
      src={heroImage}
      alt="João Garcia em seu escritório"
      widths={[640, 960, 1200, 1440]}
      sizes="(max-width: 767px) 100vw, 50vw"
      format="avif"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__image-wash" aria-hidden="true"></div>
  </div>

  <div class="hero__content container-wide">
    <div class="hero__copy">
      <p class="eyebrow eyebrow--gold" data-hero-reveal>Consultoria jurídica <span>·</span> Reforma Tributária</p>
      <h1 id="hero-title" data-hero-reveal>
        Reforma Tributária exige <em>preparo,</em><br /> não improviso.
      </h1>
      <p class="hero__lead" data-hero-reveal>
        Orientação jurídica para compreender os impactos das novas regras e tomar decisões com mais segurança e estratégia.
      </p>
      <div class="hero__actions" data-hero-reveal>
        <ButtonLink
          href={siteConfig.whatsappUrl}
          label="Falar com João pelo WhatsApp"
          icon="whatsapp"
          external
        />
      </div>
      <div class="hero__meta" data-hero-reveal>
        <span>{siteConfig.name} · {siteConfig.role}</span>
        <span>{siteConfig.education}</span>
      </div>
    </div>
  </div>
</section>
