---
import { siteConfig } from "../config/site";
import ButtonLink from "./ButtonLink.astro";

const pillars = [
  { title: "Compreender", text: "Entender o contexto e os pontos que merecem atenção." },
  { title: "Avaliar", text: "Organizar dúvidas e possíveis impactos relacionados à mudança." },
  { title: "Orientar", text: "Definir quais próximos passos podem fazer sentido para a situação apresentada." },
];
---

<section class="section consulting" id="consultoria" aria-labelledby="consulting-title">
  <div class="container-wide consulting__inner">
    <div class="consulting__main" data-reveal>
      <p class="eyebrow">Orientação jurídica estratégica</p>
      <h2 id="consulting-title">Consultoria sobre a Reforma Tributária</h2>
      <p>
        Uma análise direcionada à realidade apresentada, com linguagem objetiva e atenção ao que efetivamente pode importar para a sua situação.
      </p>
      <ButtonLink
        href={siteConfig.whatsappUrl}
        label="Quero conversar sobre meu cenário"
        variant="navy"
        icon="whatsapp"
        external
      />
    </div>
    <div class="consulting__pillars" data-reveal>
      {pillars.map((pillar) => (
        <article>
          <h3>{pillar.title}</h3>
          <p>{pillar.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
