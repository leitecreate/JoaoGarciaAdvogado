---
import { Check } from "@lucide/astro";
import { siteConfig } from "../config/site";
import ButtonLink from "./ButtonLink.astro";

const points = [
  "Compreender o contexto",
  "Identificar pontos que merecem atenção",
  "Esclarecer questões jurídicas",
  "Avaliar possíveis impactos",
  "Organizar próximos passos",
];
---

<section class="section consulting" id="consultoria" aria-labelledby="consulting-title">
  <div class="consulting__rule" data-line-reveal aria-hidden="true"></div>
  <div class="container-wide consulting__inner">
    <div class="consulting__label" data-reveal>
      <span>03</span>
      <p>Consultoria</p>
    </div>
    <div class="consulting__main" data-reveal>
      <p class="eyebrow eyebrow--gold">Orientação jurídica estratégica</p>
      <h2 id="consulting-title">Consultoria sobre a <em>Reforma Tributária</em></h2>
    </div>
    <div class="consulting__details" data-reveal>
      <p>
        A consultoria organiza a análise do cenário apresentado e ajuda a transformar um tema complexo em pontos de atenção mais claros.
      </p>
      <ul>
        {points.map((point) => (
          <li><Check size={16} stroke-width={1.7} aria-hidden="true" /><span>{point}</span></li>
        ))}
      </ul>
      <ButtonLink
        href={siteConfig.whatsappUrl}
        label="Quero entender meu cenário"
        variant="light"
        icon="whatsapp"
        external
      />
    </div>
  </div>
  <p class="consulting__ghost" aria-hidden="true">Reforma</p>
</section>
