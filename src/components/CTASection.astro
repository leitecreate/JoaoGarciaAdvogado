---
import { siteConfig } from "../config/site";
import ButtonLink from "./ButtonLink.astro";
---

<section class="cta-section" aria-labelledby="final-cta-title">
  <div class="container-wide cta-section__grid">
    <div class="cta-section__copy" data-reveal>
      <p class="eyebrow eyebrow--gold">Conversa direta com João</p>
      <h2 id="final-cta-title">Entenda como as mudanças podem impactar o seu cenário.</h2>
      <p>Explique sua situação e receba uma orientação inicial sobre como o atendimento pode seguir.</p>
    </div>
    <div class="cta-section__action" data-reveal>
      <ButtonLink
        href={siteConfig.whatsappUrl}
        label="Falar com João pelo WhatsApp"
        variant="light"
        icon="whatsapp"
        external
      />
      <small>Atendimento direto e confidencial.</small>
    </div>
  </div>
</section>
