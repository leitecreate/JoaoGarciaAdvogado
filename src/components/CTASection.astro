---
import { siteConfig } from "../config/site";
import ButtonLink from "./ButtonLink.astro";

interface Props {
  final?: boolean;
}

const { final = false } = Astro.props;
---

<section class:list={["cta-section", final && "cta-section--final"]} aria-labelledby={final ? "final-cta-title" : "mid-cta-title"}>
  <div class="cta-section__geometry" aria-hidden="true"><span></span><span></span></div>
  <div class="container-wide cta-section__grid">
    <div class="cta-section__number" aria-hidden="true">{final ? "10" : "08"}</div>
    <div data-reveal>
      <p class="eyebrow eyebrow--gold">Contato direto</p>
      <h2 id={final ? "final-cta-title" : "mid-cta-title"}>
        {final
          ? "Mudanças importantes exigem decisões bem orientadas."
          : "Não espere a mudança chegar para começar a entender os impactos."}
      </h2>
    </div>
    <div class="cta-section__action" data-reveal>
      <p>
        {final
          ? "Converse diretamente pelo WhatsApp e explique sua situação."
          : "Explique sua situação e entenda quais pontos podem merecer atenção no seu cenário."}
      </p>
      <ButtonLink
        href={siteConfig.whatsappUrl}
        label={final ? "Falar com João pelo WhatsApp" : "Falar pelo WhatsApp"}
        variant="light"
        icon="whatsapp"
        external
      />
      {final && <small>Atendimento direto e confidencial.</small>}
    </div>
  </div>
</section>
