---
const steps = [
  {
    title: "Entre em contato",
    text: "Envie uma mensagem pelo WhatsApp e explique brevemente sua dúvida.",
  },
  {
    title: "Explique sua situação",
    text: "Conte brevemente sua dúvida e o contexto que motivou o contato.",
  },
  {
    title: "Entenda como o atendimento pode seguir",
    text: "A partir das informações iniciais, é possível avaliar a aderência à consultoria.",
  },
];
---

<section class="section process" id="como-funciona" aria-labelledby="process-title">
  <div class="container-wide">
    <div class="process__header" data-reveal>
      <p class="eyebrow">Como funciona</p>
      <h2 id="process-title">Um caminho simples para começar.</h2>
    </div>
    <ol class="process__steps">
      {steps.map((step, index) => (
        <li>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
