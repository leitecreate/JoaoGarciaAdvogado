---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ReformContext from "../components/ReformContext.astro";
import TaxReformConsulting from "../components/TaxReformConsulting.astro";
import About from "../components/About.astro";
import Process from "../components/Process.astro";
import CTASection from "../components/CTASection.astro";
import FAQ from "../components/FAQ.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
import MobileWhatsAppCTA from "../components/MobileWhatsAppCTA.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout>
  <Header />
  <main id="conteudo">
    <Hero />
    <ReformContext />
    <TaxReformConsulting />
    <About />
    <Process />
    <FAQ />
    <CTASection />
  </main>
  <Footer />
  <FloatingWhatsApp />
  <MobileWhatsAppCTA />
</BaseLayout>
