---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import TrustStrip from "../components/TrustStrip.astro";
import ReformContext from "../components/ReformContext.astro";
import ClientQuestions from "../components/ClientQuestions.astro";
import TaxReformConsulting from "../components/TaxReformConsulting.astro";
import Positioning from "../components/Positioning.astro";
import About from "../components/About.astro";
import Process from "../components/Process.astro";
import ContentSection from "../components/ContentSection.astro";
import CTASection from "../components/CTASection.astro";
import FAQ from "../components/FAQ.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
import MobileWhatsAppCTA from "../components/MobileWhatsAppCTA.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout>
  <Header />
  <main id="conteudo">
    <Hero />
    <TrustStrip />
    <ReformContext />
    <ClientQuestions />
    <TaxReformConsulting />
    <Positioning />
    <About />
    <Process />
    <ContentSection />
    <CTASection />
    <FAQ />
    <CTASection final />
  </main>
  <Footer />
  <FloatingWhatsApp />
  <MobileWhatsAppCTA />
</BaseLayout>
